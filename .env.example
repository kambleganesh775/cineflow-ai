# ==========================================
# CINEFLOW AI — ENVIRONMENT CONFIGURATION
# Strictly Private Personal Video Studio
# ==========================================

# 1. Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=promptwars-494613
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=cineflow-ai-private-videos-promptwars-494613
FIREBASE_PROJECT_ID=promptwars-494613

# 2. Vertex AI Veo Configuration
# Available model IDs: veo-2.0-generate-001, veo-3.0-generate-001
VEO_MODEL_ID=veo-2.0-generate-001

# 3. Application Security & Access Control
# Set this to your Google Account email. Anyone who clones this can put their own email.
# You can also provide multiple comma-separated emails in AUTHORIZED_EMAILS.
AUTHORIZED_OWNER_EMAIL=your-google-email@gmail.com
AUTHORIZED_EMAILS=your-google-email@gmail.com

# Port for backend API
API_PORT=4000
API_BASE_URL=http://localhost:4000
APP_BASE_URL=http://localhost:3000

# 4. Identity & Authentication Modes
# Modes: "local_dev" (works instantly for anyone in development without auth roadblocks),
#        "google_oauth" (verifies Google ID Token Bearer header against Google OAuth2 certs),
#        "google_iap" (verifies x-goog-iap-jwt-assertion header on Google Cloud Run with IAP)
AUTH_MODE=local_dev

# Google OAuth Client ID (Required if AUTH_MODE=google_oauth)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 5. Cost & Safety Controls
# Maximum allowed generation duration per scene (seconds: 5 to 8)
MAX_SCENE_DURATION_SECONDS=8
# Maximum scenes per project
MAX_SCENES_PER_PROJECT=20
# Maximum concurrent video generation jobs
MAX_CONCURRENT_JOBS=2
# Require explicit user confirmation flag before executing billable Vertex calls
REQUIRE_BILLING_CONFIRMATION=true
# Test mode: if set to true, returns simulated realistic video metadata without billing Vertex AI
MOCK_VERTEX_AI=false

# 6. Storage & Rendering
# Local temp directory for assembling videos when running locally
LOCAL_TEMP_DIR=./temp_renders
