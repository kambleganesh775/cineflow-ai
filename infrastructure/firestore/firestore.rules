rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dynamic personal database: Allows authenticated owner of the project/resource
    function isAuthorizedUser() {
      return request.auth != null && request.auth.token.email != null;
    }

    match /projects/{projectId} {
      allow read, write: if isAuthorizedUser() && (resource == null || resource.data.ownerEmail == request.auth.token.email);
    }

    match /scenes/{sceneId} {
      allow read, write: if isAuthorizedUser();
    }

    match /jobs/{jobId} {
      allow read, write: if isAuthorizedUser();
    }

    match /renders/{renderId} {
      allow read, write: if isAuthorizedUser();
    }
  }
}
